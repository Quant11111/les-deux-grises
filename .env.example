# ---------------------------------------------------------------------------
# Les Deux Grises — environment variables
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Prisma).
# Local dev DB is provided by docker-compose.yml (port 5433).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/postgres?schema=public"

# ---- Admin panel ( /[locale]/admin ) --------------------------------------

# Password required to log into the admin panel.
ADMIN_PASSWORD="change-me"

# Optional but recommended: dedicated secret used to sign the admin session
# cookie. If omitted, ADMIN_PASSWORD is used as the signing secret (which means
# every password change invalidates existing sessions).
ADMIN_SESSION_SECRET="a-long-random-string"

# ---- Image storage (S3 + CDN) ---------------------------------------------
# Horse images are uploaded to S3 from the admin and served back through a CDN.
# Only the S3 *key* is stored on each horse (e.g. ldgexportsquentin/horse/...).
#
# These 4 are REQUIRED for the admin image upload to work:
S3_REGION="eu-west-3"
S3_BUCKET="lesdeuxgrises"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"

# Optional: prefix prepended to every uploaded key (default below).
S3_KEY_PREFIX=""

# Optional: custom S3-compatible endpoint (e.g. for non-AWS providers).
# S3_ENDPOINT="https://s3.example.com"

# Optional: CDN base URL used to BUILD the public image URLs.
# Defaults to the current CloudFront distribution if unset.
# NOTE: if you change the host, add it to `images.remotePatterns` in next.config.mjs.
NEXT_PUBLIC_CDN_URL="https://dsq73kname7kn.cloudfront.net"

# ---- Legacy --------------------------------------------------------------
# Currently unused by the codebase; kept for backward compatibility.
NEXT_PUBLIC_API_URL=""
